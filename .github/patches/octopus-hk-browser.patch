# 港股境外数据源 · GitHub Actions 开关补丁（2026-10-02）
#
# 背景：本仓库的 GitHub App 令牌没有 workflows 权限，改不了 .github/workflows/*。
# 本补丁给 octopus-daily.yml / manual.yml 注入 OCTOPUS_HK_* 三个开关，并在
# OCTOPUS_HK_BROWSER=1 时多跑一步安装 stealth 浏览器（patchright + Chrome）。
#
# 应用：  git apply .github/patches/octopus-hk-browser.patch
# 撤销：  git apply -R .github/patches/octopus-hk-browser.patch
#
# 说明：不应用补丁也完全不影响功能——三路纯 HTTP 境外源（Yahoo / Stooq / HKEX）
#       默认开启、无需任何配置；该补丁只是让 Actions 侧能切换到浏览器第 4 路。

diff --git a/.github/workflows/manual.yml b/.github/workflows/manual.yml
index 27f4f6c..6f355a6 100644
--- a/.github/workflows/manual.yml
+++ b/.github/workflows/manual.yml
@@ -36,6 +36,9 @@ jobs:
       - name: 🐙 抓取最新动态数据并推送
         env:
           PUSHPLUS_TOKEN: ${{ secrets.PUSHPLUS_TOKEN }}
+          # 🇭🇰 港股境外数据源开关（留空 = 默认；OCTOPUS_HK_BROWSER=1 需先安装本目录 Node 依赖）
+          OCTOPUS_HK_OVERSEAS: ${{ vars.OCTOPUS_HK_OVERSEAS }}
+          OCTOPUS_HK_BROWSER: ${{ vars.OCTOPUS_HK_BROWSER }}
         run: |
           set -euo pipefail
           NO_PUSH="${{ github.event.inputs.no_push || 'false' }}"
diff --git a/.github/workflows/octopus-daily.yml b/.github/workflows/octopus-daily.yml
index a3b2f95..e0624bb 100644
--- a/.github/workflows/octopus-daily.yml
+++ b/.github/workflows/octopus-daily.yml
@@ -55,6 +55,16 @@ jobs:
           python -m pip install --upgrade pip --quiet
           pip install --quiet requests
 
+      - name: 🕶️ （可选）安装 stealth 浏览器 —— 仅在仓库变量 OCTOPUS_HK_BROWSER=1 时执行
+        # 用 patchright 读带 WAF 的香港财经站点（etnet / aastocks / HKEX）需要 Node + Chrome；
+        # 不设置该变量时整步跳过，三路 HTTP 境外源照常工作。
+        if: ${{ vars.OCTOPUS_HK_BROWSER == '1' }}
+        working-directory: tools/patchright-enhanced
+        run: |
+          set -euo pipefail
+          npm install --no-audit --no-fund
+          npx patchright install chrome
+
       - name: 🐙 运行章鱼AI流水线
         env:
           PUSHPLUS_TOKEN: ${{ secrets.PUSHPLUS_TOKEN }}
@@ -69,6 +79,12 @@ jobs:
           # OCTOPUS_LLM_MAX_TOKENS: "2048"     # JSON 被截断时调大
           # OCTOPUS_LLM_TIMEOUT: "60"
           # OCTOPUS_HK7_FALLBACK: "1"
+          # 🇭🇰 港股境外数据源（【深水石斑鱼】港股行情）：
+          #   留空 = 默认（Yahoo + Stooq + HKEX 三路纯 HTTP 取数，不装浏览器）
+          #   要开 stealth 浏览器第 4 路：仓库 Variables 设 OCTOPUS_HK_BROWSER=1（见下方安装步骤）
+          OCTOPUS_HK_OVERSEAS: ${{ vars.OCTOPUS_HK_OVERSEAS }}
+          OCTOPUS_HK_BROWSER: ${{ vars.OCTOPUS_HK_BROWSER }}
+          OCTOPUS_HK_CROSSCHECK: ${{ vars.OCTOPUS_HK_CROSSCHECK }}
         run: |
           set -euo pipefail
           EVENT_NAME="${{ github.event_name }}"
